[Unit]
Description=Arch unattended gated system upgrade
Documentation=man:pacman(8)
# Only run online; avoid mid-boot contention.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/arch-unattended-update
Nice=10
IOSchedulingClass=idle
# No timeout: a SIGTERM mid-`pacman -Syu` can interrupt the transaction.
# Let a large upgrade on a slow mirror finish rather than risk a kill.
TimeoutStartSec=0
