#!/usr/bin/env bash
# auu-notify — send a desktop notification to every active graphical user.
#
# Runs as root (from the system service) but delivers notify-send into each
# logged-in user's session bus. Usage:
#   auu-notify <urgency> <summary> [body]
# urgency: low | normal | critical
set -euo pipefail

urgency="${1:-normal}"
summary="${2:-arch-unattended}"
body="${3:-}"

sent=0

# Enumerate sessions; pick graphical (x11/wayland) ones that are active.
while read -r sid; do
    [[ -n "$sid" ]] || continue

    # Parse loginctl output into locals WITHOUT eval — the username (Name) is
    # attacker-influenceable in principle and must never reach the shell as code.
    s_type="" s_state="" s_name="" s_user=""
    while IFS='=' read -r key val; do
        case "$key" in
            Type)  s_type="$val" ;;
            State) s_state="$val" ;;
            Name)  s_name="$val" ;;
            User)  s_user="$val" ;;
        esac
    done < <(loginctl show-session "$sid" \
        -p Type -p State -p Name -p User 2>/dev/null)

    case "$s_type" in
        x11|wayland) ;;
        *) continue ;;
    esac

    # Only notify live sessions; skip closing/lingering ones.
    case "$s_state" in
        active|online) ;;
        *) continue ;;
    esac

    uid="$s_user"
    user="$s_name"
    [[ -n "$uid" && -n "$user" ]] || continue

    bus="/run/user/${uid}/bus"
    [[ -S "$bus" ]] || continue

    icon=dialog-information
    [[ "$urgency" == critical ]] && icon=dialog-warning

    # runuser (util-linux, always in base) drops to the target user. sudo is
    # NOT guaranteed on Arch — base ships neither sudo nor doas.
    runuser -u "$user" -- \
        env DBUS_SESSION_BUS_ADDRESS="unix:path=${bus}" \
        notify-send \
            --app-name="Arch Unattended Updates" \
            --urgency="$urgency" \
            --icon="$icon" \
            -- "$summary" "$body" 2>/dev/null && sent=1 || true

done < <(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}')

# Fall back to a log line if nobody was notified (headless run, etc.)
if [[ "$sent" -eq 0 ]]; then
    logger -t arch-unattended -- "notify (no graphical session): ${summary} — ${body}"
fi
