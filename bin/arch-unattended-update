#!/usr/bin/env bash
# arch-unattended-update — gated unattended full-system upgrade for Arch Linux.
#
# Model: Arch does NOT support partial upgrades, so this either runs a full
# `pacman -Syu` (when every gate passes) or holds the entire transaction and
# notifies you for manual review. Never a partial upgrade.
#
# Gates (any trip => hold + notify):
#   * unread Arch news       (informant)
#   * blacklisted package    (config BLACKLIST)
#
# Snapshots are expected to be handled by snap-pac (alpm pre/post hooks), so
# this script does not manage snapper directly.
#
# Usage: arch-unattended-update [--dry-run] [-h|--help]
#   --dry-run  evaluate gates and report what WOULD happen; no upgrade,
#              no state write, no notification.
set -euo pipefail

DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --dry-run|-n) DRY_RUN=1 ;;
        -h|--help)
            cat <<'EOF'
Usage: arch-unattended-update [--dry-run] [-h|--help]

  --dry-run, -n   Evaluate gates and report what WOULD happen. No upgrade,
                  no state write, no notification. Runs without root.
  -h, --help      This help.
EOF
            exit 0 ;;
        *) echo "unknown arg: $arg" >&2; exit 2 ;;
    esac
done

CONFIG="${AUU_CONFIG:-/etc/arch-unattended/config}"
STATE_DIR="/var/lib/arch-unattended"
STATE_FILE="${STATE_DIR}/status.json"
SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
NOTIFY="${SELF_DIR}/auu-notify"
LOG_TAG=arch-unattended

# ---- defaults (overridden by config) --------------------------------------
BLACKLIST=()
REBOOT_TRIGGERS=(linux linux-lts linux-zen systemd glibc)
PACMAN_ARGS=()
AUDIT=1
CHECK_NEWS=1
REBOOT_POLICY=notify

log()    { logger -t "$LOG_TAG" -- "$*"; echo "[$LOG_TAG] $*"; }
notify() {
    if [[ "$DRY_RUN" -eq 1 ]]; then log "[dry-run] would notify: $*"; return 0; fi
    if [[ -x "$NOTIFY" ]]; then
        "$NOTIFY" "$@" || log "notify helper failed: $*"
    else
        log "notify: $*"
    fi
}

have()   { command -v "$1" >/dev/null 2>&1; }

# JSON-escape a string.
json_str() {
    local s=${1//\\/\\\\}
    s=${s//\"/\\\"}
    s=${s//$'\n'/\\n}
    printf '"%s"' "$s"
}

write_status() {
    # write_status <state> <held_reason> <count> <pkgs-newline-list>
    if [[ "$DRY_RUN" -eq 1 ]]; then log "[dry-run] would set state: $1${2:+ ($2)}"; return 0; fi
    mkdir -p "$STATE_DIR"
    {
        printf '{\n'
        printf '  "state": %s,\n'   "$(json_str "$1")"
        printf '  "reason": %s,\n'  "$(json_str "$2")"
        printf '  "count": %s,\n'   "$3"
        printf '  "packages": %s,\n' "$(json_str "$4")"
        printf '  "timestamp": %s\n' "$(json_str "$(date -Iseconds)")"
        printf '}\n'
    } > "$STATE_FILE"
}

[[ $EUID -eq 0 || "$DRY_RUN" -eq 1 ]] || { echo "must run as root" >&2; exit 1; }

# Config is sourced as bash => arbitrary code runs as root. Refuse to source it
# unless it is owned by root and not writable by group/other, so a non-root user
# cannot inject commands into the privileged run.
safe_to_source() {
    local f="$1" owner perm
    owner="$(stat -c '%u' "$f" 2>/dev/null)" || return 1
    perm="$(stat -c '%a' "$f" 2>/dev/null)" || return 1
    [[ "$owner" == "0" ]] || return 1
    # last two octal digits = group/other; any write bit (2) => unsafe.
    (( (0${perm} & 022) == 0 ))
}
if [[ -r "$CONFIG" ]]; then
    if [[ "$DRY_RUN" -eq 1 ]] || safe_to_source "$CONFIG"; then
        # shellcheck source=/dev/null
        source "$CONFIG"
    else
        log "refusing to source $CONFIG: must be root-owned and not group/world-writable; using defaults"
    fi
fi

# ---- 0. pacman lock -------------------------------------------------------
# If a transaction is already in progress (manual upgrade, another hook),
# skip cleanly instead of failing the run on db.lck. Only meaningful for a
# real upgrade run; a dry-run touches nothing.
PACMAN_LOCK="${PACMAN_LOCK:-/var/lib/pacman/db.lck}"
if [[ "$DRY_RUN" -eq 0 && -e "$PACMAN_LOCK" ]]; then
    log "pacman is locked ($PACMAN_LOCK) — another transaction in progress; skipping"
    write_status "skipped" "pacman locked" 0 ""
    exit 0
fi

# ---- 1. pending updates ---------------------------------------------------
have checkupdates || { log "checkupdates missing (install pacman-contrib)"; exit 1; }

# checkupdates: exit 0 = updates, 2 = none, other = error. Guard `set -e`.
pending=""
set +e
pending="$(checkupdates 2>/dev/null)"
cu_rc=$?
set -e
case "$cu_rc" in
    0) ;;
    2) log "no pending updates"; write_status "up-to-date" "" 0 ""; exit 0 ;;
    *) log "checkupdates failed (rc=$cu_rc)"; exit 1 ;;
esac

# names only
mapfile -t pending_pkgs < <(awk '{print $1}' <<<"$pending")
count=${#pending_pkgs[@]}
[[ $count -eq 0 ]] && { write_status "up-to-date" "" 0 ""; exit 0; }
log "$count pending update(s)"

# ---- 2. security tagging (arch-audit) -------------------------------------
# arch-audit reports ALL installed vulnerable packages with an available fix,
# not just the ones pending in this run. Intersect with pending_pkgs so the
# count reflects "pending updates that carry a CVE fix".
sec_note=""
if [[ "$AUDIT" -eq 1 ]] && have arch-audit; then
    set +e
    vuln="$(arch-audit -uq 2>/dev/null)"
    set -e
    if [[ -n "$vuln" ]]; then
        # arch-audit -q may emit "pkg>=fixed-ver"; keep the name only.
        declare -A pending_set=()
        for p in "${pending_pkgs[@]}"; do pending_set["$p"]=1; done
        vuln_pending=()
        while read -r vline; do
            [[ -n "$vline" ]] || continue
            vname="${vline%%>*}"; vname="${vname%%<*}"; vname="${vname%%=*}"
            [[ -n "${pending_set[$vname]:-}" ]] && vuln_pending+=("$vname")
        done <<<"$vuln"
        if [[ ${#vuln_pending[@]} -gt 0 ]]; then
            sec_note=" (${#vuln_pending[@]} pending with known CVE)"
            log "arch-audit: ${#vuln_pending[@]} pending package(s) carry a CVE fix: ${vuln_pending[*]}"
        fi
    fi
fi

# ---- 3. GATE A: Arch news (informant) -------------------------------------
if [[ "$CHECK_NEWS" -eq 1 ]] && have informant; then
    set +e
    informant check >/dev/null 2>&1
    news_rc=$?
    set -e
    if [[ $news_rc -ne 0 ]]; then
        log "HOLD: unread Arch news"
        write_status "held" "unread Arch news — read with: informant read" \
            "$count" "$(printf '%s\n' "${pending_pkgs[@]}")"
        notify critical "Updates held: unread Arch news" \
            "${count} update(s) pending${sec_note}. Read news then upgrade manually: informant read && pacman -Syu"
        exit 0
    fi
fi

# ---- 4. GATE B: blacklist -------------------------------------------------
held=()
for pkg in "${pending_pkgs[@]}"; do
    for pat in "${BLACKLIST[@]}"; do
        # shellcheck disable=SC2053
        if [[ "$pkg" == $pat ]]; then
            held+=("$pkg")
            break
        fi
    done
done

if [[ ${#held[@]} -gt 0 ]]; then
    held_list="${held[*]}"
    log "HOLD: blacklisted package(s): $held_list"
    write_status "held" "blacklisted: $held_list" \
        "$count" "$(printf '%s\n' "${pending_pkgs[@]}")"
    notify critical "Updates held for manual review" \
        "Blacklisted: ${held_list}. ${count} total pending${sec_note}. Review then: pacman -Syu"
    exit 0
fi

# ---- 5. upgrade -----------------------------------------------------------
if [[ "$DRY_RUN" -eq 1 ]]; then
    log "[dry-run] gates clear — WOULD run: pacman -Syu --noconfirm ${PACMAN_ARGS[*]}"
    log "[dry-run] ${count} package(s) would be upgraded${sec_note}"
    printf '%s\n' "${pending_pkgs[@]}" | sed 's/^/  /'
    exit 0
fi

log "gates clear — running full upgrade"
# Snapshot pre-existing .pacnew files so post-run we report only NEW ones,
# not stale pacnew left unmerged from earlier upgrades.
declare -A pacnew_before=()
while read -r f; do [[ -n "$f" ]] && pacnew_before["$f"]=1; done \
    < <(find /etc -name '*.pacnew' 2>/dev/null)

set +e
pacman -Syu --noconfirm "${PACMAN_ARGS[@]}"
up_rc=$?
set -e
if [[ $up_rc -ne 0 ]]; then
    log "upgrade FAILED (rc=$up_rc) — snapshot available via snapper if rollback needed"
    write_status "failed" "pacman exit $up_rc" \
        "$count" "$(printf '%s\n' "${pending_pkgs[@]}")"
    notify critical "Unattended upgrade FAILED" \
        "pacman exited ${up_rc}. Check: journalctl -t ${LOG_TAG}. Rollback: snapper rollback"
    exit "$up_rc"
fi
log "upgrade OK"

# ---- 6. post: .pacnew -----------------------------------------------------
# Report only .pacnew files created by THIS run (not pre-existing stale ones).
pacnew=()
while read -r f; do
    [[ -n "$f" ]] || continue
    [[ -n "${pacnew_before[$f]:-}" ]] && continue
    pacnew+=("$f")
done < <(find /etc -name '*.pacnew' 2>/dev/null)
pacnew_note=""
if [[ ${#pacnew[@]} -gt 0 ]]; then
    pacnew_note=" ${#pacnew[@]} new .pacnew file(s) need merging."
    log "new .pacnew files: ${pacnew[*]}"
fi

# ---- 7. post: reboot recommendation ---------------------------------------
reboot_note=""
if [[ "$REBOOT_POLICY" != never ]]; then
    for pkg in "${pending_pkgs[@]}"; do
        for trig in "${REBOOT_TRIGGERS[@]}"; do
            # shellcheck disable=SC2053
            # glob match, consistent with BLACKLIST (e.g. linux-* / nvidia*).
            if [[ "$pkg" == $trig ]]; then
                reboot_note=" Reboot recommended (${pkg} updated)."
                break 2
            fi
        done
    done
fi
[[ -n "$reboot_note" ]] && log "reboot recommended"

# ---- 8. status + notify ---------------------------------------------------
write_status "upgraded" "" "$count" "$(printf '%s\n' "${pending_pkgs[@]}")"

summary="Upgraded ${count} package(s)"
[[ -n "$sec_note" ]] && summary="${summary}${sec_note}"
body="Done.${reboot_note}${pacnew_note}"
urgency=normal
[[ -n "$reboot_note" || -n "$pacnew_note" ]] && urgency=critical
notify "$urgency" "$summary" "$body"
log "run complete"
